# =============================================================================
# Kami web app — copy to web/.env.local. Never commit real values.
# Everything below "Required" is optional: each block unlocks one capability,
# and the app explains what is missing (GET /api/capabilities, readiness).
# =============================================================================

# --- Required -------------------------------------------------------------------
# Hermes API server (see root .env.example for the Hermes side).
HERMES_GATEWAY_URL=http://127.0.0.1:8642/v1/chat/completions
# Same value as API_SERVER_KEY in your Hermes .env
HERMES_API_KEY=

# Your own Supabase project. The app creates tables on startup.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-only key. Never expose it to a browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection (Project Settings → Database). Used only to apply migrations.
# Local `supabase start` is detected automatically when the URL above is 127.0.0.1.
# DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- Access ---------------------------------------------------------------------
# Without a token Kami only serves localhost. Set one before exposing Kami on a
# network; sign in at /login.   openssl rand -hex 32
# KAMI_ADMIN_TOKEN=
# Lets cron / Hermes cron call /api/jobs/* with "Authorization: Bearer <secret>".
# KAMI_CRON_SECRET=
# Public URL of this app (OAuth redirects default to <APP_URL>/api/auth/<platform>/callback).
# APP_URL=http://localhost:3000
# Run reply polling inside the app (every 5–10 min) instead of external cron.
# KAMI_SCHEDULER=on

# --- Agents ---------------------------------------------------------------------
# Model name sent to Hermes; "hermes-agent" uses the model configured in Hermes.
# HERMES_MODEL=hermes-agent
# HERMES_TIMEOUT_MS=90000
# Where Hermes keeps its state (Activity → Hermes reads it when local).
# Defaults: ~/.hermes, or %LOCALAPPDATA%\hermes on Windows.
# HERMES_HOME=
# Dedicated Chrome profile for browser research (see scripts/browser-connect.md).
# HERMES_BROWSER_CDP_URL=http://127.0.0.1:9222

# --- Research providers (pick any; first configured wins) ------------------------
# LINKUP_API_KEY=
# EXA_API_KEY=
# TAVILY_API_KEY=

# --- Email: send and receive (AgentMail) ------------------------------------------
# Without these, Sales drafts emails but cannot send.
# AGENTMAIL_API_KEY=
# AGENTMAIL_INBOX=you@agentmail.to
# Webhook signing secret (whsec_…) for POST /api/webhooks/agentmail. Without it,
# replies are picked up by the polling job instead.
# AGENTMAIL_WEBHOOK_SECRET=

# --- Connected accounts (X, Instagram) ----------------------------------------------
# Required before connecting any account: OAuth tokens are encrypted with it.
#   openssl rand -base64 32
# KAMI_TOKEN_ENCRYPTION_KEY=

# X: post, read engagement, DMs. Step by step: docs/marketing-credentials.md
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=http://localhost:3000/api/auth/x/callback

# Instagram (Advanced CRM / creator DMs)
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback
# Verify token you choose when subscribing the Meta webhook (/api/webhooks/instagram)
# INSTAGRAM_WEBHOOK_VERIFY_TOKEN=

# Instagram creator discovery via Apify (finds creators; never sends)
# APIFY_API_TOKEN=
# APIFY_IG_HASHTAG_ACTOR=apify~instagram-hashtag-scraper

# X Ads — boost your own posts (real spend; every boost is confirmed first).
# Needs Ads API access, OAuth 1.0a user tokens and an active funding instrument:
# docs/marketing-credentials.md
# X_ADS_CONSUMER_KEY=
# X_ADS_CONSUMER_SECRET=
# X_ADS_ACCESS_TOKEN=
# X_ADS_ACCESS_TOKEN_SECRET=
# X_ADS_ACCOUNT_ID=
# X_ADS_FUNDING_INSTRUMENT_ID=

# --- Meetings (Google Calendar) -----------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=

# --- Observability --------------------------------------------------------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
