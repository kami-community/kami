# =============================================================================
# Hermes home .env — for the Hermes agent runtime, not the web app.
#   macOS / Linux:  ~/.hermes/.env
#   Windows:        %LOCALAPPDATA%\hermes\.env
# The web app has its own template: web/.env.example
# Never commit real values.
# =============================================================================

# --- Model provider (set at least one) ---------------------------------------
OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- API server (required: the web app talks to Hermes through it) -----------
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
# Long random secret; put the same value in web/.env.local as HERMES_API_KEY.
#   openssl rand -hex 32
API_SERVER_KEY=

# --- Research tools for agents (optional) ------------------------------------
# Kami also passes search results from the web app; these let Hermes agents
# search on their own (e.g. Kami Guide delegations).
# LINKUP_API_KEY=
# EXA_API_KEY=
# TAVILY_API_KEY=
